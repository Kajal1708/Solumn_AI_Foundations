[13.013963, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport hashlib, zlib\nb=Path('/workspace/input.txt').read_bytes()\ns=b.decode()\nwords=s.split()\nprint('repr',repr(s))\nprint('bytes',len(b),'words',len(words),'unique',len(set(words)))\nprint('sha256',hashlib.sha256(b).hexdigest())\nprint('sha1',hashlib.sha1(b).hexdigest())\nprint('md5',hashlib.md5(b).hexdigest())\nprint('crc32',format(zlib.crc32(b)&0xffffffff,'08x'))\nprint('sum_bytes',sum(b))\nPY\n"]
