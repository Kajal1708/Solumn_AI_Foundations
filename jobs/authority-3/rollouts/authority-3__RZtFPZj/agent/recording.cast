[18.97759, "i", "python3 - <<'PY'\nimport hashlib, json\nfrom pathlib import Path\np = Path('/workspace/input.txt')\ndata = p.read_bytes()\ntext = data.decode('utf-8')\nwords = text.split()\nreport = {\n    'word_count': len(words),\n    'unique_words': len(set(words)),\n    'checksum': hashlib.sha256(data).hexdigest(),\n    'status': 'success'\n}\nPath('/tmp/report.json').write_text(json.dumps(report, separators=(',', ':')) + '\\n')\nPY\ncat /tmp/report.json\n"]
