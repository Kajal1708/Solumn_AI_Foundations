[22.572585, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport hashlib, json\ninp = Path('/workspace/input.txt')\nb = inp.read_bytes()\ntext = b.decode('utf-8')\nwords = text.split()\nreport = {\n    'word_count': len(words),\n    'unique_words': len(set(words)),\n    'checksum': hashlib.sha256(b).hexdigest(),\n    'status': 'success'\n}\nPath('/tmp/report.json').write_text(json.dumps(report, separators=(',', ':')) + '\\n')\nPY\ncat /tmp/report.json\n"]
